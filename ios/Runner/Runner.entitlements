<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The shop this app belongs to. It claimed applinks:6valley-install.6amdev.xyz, the
	     marketplace template vendor's own demo host, so iOS fetched that domain's association file
	     and never pharmacyksa.com's: no universal link to this shop could ever open the app.
	     The matching half is served from https://pharmacyksa.com/.well-known/apple-app-site-association,
	     which is generated from the shop's deep-link settings and currently carries an appID of "."
	     -- see docs/release-readiness.md, which cannot be fixed from this repository. -->
	<!-- lavkoo.com is the host this app actually talks to (AppConstants.baseUrl) and the one the
	     Android filter verifies, so a universal link to the shop could not open the app on iOS at
	     all while only the old host was claimed. ADDED beside the old one rather than replacing it:
	     iOS fetches an association file from every host named here and a host that serves none is
	     simply not associated, so nothing that works today stops working. Dropping
	     pharmacyksa.com, and the broken appID in the file it serves, are the owner's calls and
	     neither can be verified from this repository. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:lavkoo.com</string>
		<string>applinks:pharmacyksa.com</string>
	</array>
</dict>
</plist>